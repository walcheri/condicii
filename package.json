{
  "name": "potential-conditions-site",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "concurrently -k \"node --watch server.js\" \"vite --host 127.0.0.1\"",
    "build": "vite build",
    "test": "node --test tests/*.test.js",
    "test:browser": "npm run build && playwright test"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "express": "^5.1.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@vitejs/plugin-react": "^5.1.0",
    "concurrently": "^9.2.0",
    "vite": "^7.2.0"
  }
}
